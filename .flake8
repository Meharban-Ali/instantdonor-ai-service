# ai-service/.flake8
# Fallback — agar flake8-pyproject nahi hai

[flake8]
max-line-length = 88
extend-ignore =
    E203,
    W503,
    E501,
    F401
exclude =
    .git,
    __pycache__,
    venv,
    .venv,
    alembic/versions
per-file-ignores =
    __init__.py:F401
    tests/*:S101
max-complexity = 10