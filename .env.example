# ============================================================
#   AI BLOOD DONOR SERVICE — .env.example
#   Version: 1.0.0 | Python 3.11+ | FastAPI
# ============================================================

# ─────────────────────────────────────────────────────────
# 1. APPLICATION
# ─────────────────────────────────────────────────────────
APP_NAME=blood-donor-ai-service
APP_VERSION=1.0.0
# development | staging | production
ENVIRONMENT=development
# Set to false in production!
DEBUG=false

# ─────────────────────────────────────────────────────────
# 2. SERVER
# ─────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
SPRING_BOOT_URL=http://localhost:8080

# ─────────────────────────────────────────────────────────
# 3. DATABASE (Least Privilege: Read-Only User)
# ─────────────────────────────────────────────────────────
# Security Best Practice: Use a dedicated read-only database user restricted to
# donor_profiles, users (id, is_active), and blood_requests.
# Minimal Permissions required (NO access to users.phone, email, password):
#   CREATE USER 'ai_readonly_user'@'%' IDENTIFIED BY 'secure_readonly_password';
#   GRANT SELECT (id, user_id, blood_group, city, latitude, longitude, is_available, last_donation_date, next_eligible_date, reliability_score, total_donations, response_rate) ON blood_donor_db.donor_profiles TO 'ai_readonly_user'@'%';
#   GRANT SELECT (id, is_active) ON blood_donor_db.users TO 'ai_readonly_user'@'%';
#   GRANT SELECT (id, city, blood_group, urgency, created_at) ON blood_donor_db.blood_requests TO 'ai_readonly_user'@'%';
DB_URL=mysql+pymysql://ai_readonly_user:secure_readonly_password@localhost:3306/blood_donor_db_dev

# Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
# SQL logging — true in dev, false in prod
DB_ECHO=false

# ─────────────────────────────────────────────────────────
# 4. REDIS
# ─────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# Leave empty if no password is used
REDIS_PASSWORD=
REDIS_DB=0
# false for local, true for production Redis
REDIS_SSL=false

# Cache TTL (seconds)
REDIS_TTL_DONOR_SEARCH=300
REDIS_TTL_PREDICTION=600
REDIS_TTL_MODEL=3600

# ─────────────────────────────────────────────────────────
# 5. SECURITY
# ─────────────────────────────────────────────────────────
# Min 32 chars — MUST match Spring Boot JWT secret!
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long
# HS256 | HS384 | HS512 — MUST match Spring Boot!
JWT_ALGORITHM=HS384
# Internal service API key for authentication
API_KEY=your_internal_service_api_key
# Allowed CORS origins in JSON array format
CORS_ORIGINS=["http://localhost:8080", "http://localhost:3000", "http://localhost:5173"]

# ─────────────────────────────────────────────────────────
# 6. ML MODEL
# ─────────────────────────────────────────────────────────
MODEL_PATH=models/donor_matching_model.pkl
MODEL_SHA256=d31d40988940d64a20b655d8239080cfacb0436ac248c9f9fcaf50ba00264236
MODEL_VERSION=1.0.0
MAX_DONORS_RESULT=10
DEFAULT_RADIUS_KM=50.0
MAX_RADIUS_KM=100.0
MIN_SAMPLES_FOR_RETRAIN=100
MODEL_LOADED=false

# ─────────────────────────────────────────────────────────
# 7. AI SCORING WEIGHTS
# ⚠️  MUST sum to exactly 1.0!
# ─────────────────────────────────────────────────────────
WEIGHT_DISTANCE=0.40
WEIGHT_RELIABILITY=0.30
WEIGHT_ELIGIBILITY=0.20
WEIGHT_RESPONSE_RATE=0.10

# ─────────────────────────────────────────────────────────
# 8. LOGGING
# ─────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
LOG_FILE=logs/ai-service.log
# Structured logging (JSON format)
LOG_STRUCTURED=false

# ─────────────────────────────────────────────────────────
# 9. MONITORING
# ─────────────────────────────────────────────────────────
METRICS_ENABLED=true
METRICS_PORT=9090
HEALTH_CHECK_ENABLED=true

# ─────────────────────────────────────────────────────────
# 10. RATE LIMITING
# ─────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60
